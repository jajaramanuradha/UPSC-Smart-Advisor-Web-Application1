*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f5f7fb;color:#222}nav{background:#182848;color:white;padding:18px 7%;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0}nav a{color:white;text-decoration:none;margin:0 8px}.hero{text-align:center;padding:100px 20px;background:linear-gradient(135deg,#182848,#4b6cb7);color:white}.hero h1{font-size:46px}.btn{display:inline-block;background:#ffd700;color:#111;border:0;padding:12px 20px;border-radius:6px;text-decoration:none;font-weight:bold;cursor:pointer}section{padding:60px 8%}h2{text-align:center;color:#182848;margin-bottom:30px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:20px}.card,.box{background:white;padding:25px;border-radius:10px;box-shadow:0 3px 12px #0001}.card{text-align:center}.search,input,select{width:100%;padding:12px;margin:10px 0 20px;border:1px solid #ccc;border-radius:6px}.option{display:block;padding:12px;margin:8px 0;background:#f1f1f1;border-radius:6px}.progress{height:25px;background:#ddd;border-radius:15px;overflow:hidden}.progress div{width:0;height:100%;background:#4b6cb7;color:white;text-align:center;line-height:25px}footer{background:#182848;color:white;text-align:center;padding:25px}@media(max-width:700px){nav{flex-direction:column;gap:12px}.hero h1{font-size:32px}}