let progress=0;function addTask(){const i=document.getElementById('task'),t=i.value.trim();if(!t)return;const d=document.createElement('div');d.className='card';d.style.margin='10px 0';d.innerHTML='<b>'+t+'</b> <button onclick="this.parentElement.remove();updateProgress()">✓</button>';document.getElementById('tasks').appendChild(d);i.value='';updateProgress()}function updateProgress(){const n=document.querySelectorAll('#tasks .card').length;progress=Math.min(100,n*10);document.getElementById('bar').style.width=progress+'%';document.getElementById('bar').textContent=progress+'%'}